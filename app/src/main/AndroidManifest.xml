<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.zalocn"
    android:versionCode="18"
    android:versionName="2.7.0">

    <uses-sdk android:minSdkVersion="27" android:targetSdkVersion="34" />

    <!-- 待办提醒到点触发：精确闹钟 + 通知 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="Zalo 汉化"
        android:allowBackup="false"
        android:extractNativeLibs="false">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Zalo 界面汉化 + 消息实时翻译：将 Zalo 英文/越南语界面翻译为简体中文（纯 UI 字符串替换，不改网络与账号数据）；消息翻译走用户自填的大模型 API" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <!-- LSPosed API 93+ 新版 XSharedPreferences：声明后 LSPosed 把模块 prefs
             重定向到共享位置，仅作用域内的 Zalo 进程可读，普通 App 读不到。
             旧硬编码路径在安卓 16 上会被 SELinux 拦，故必须声明此项。 -->
        <meta-data
            android:name="xposedsharedprefs"
            android:value="true" />
        <meta-data
            android:name="xposedscope"
            android:value="com.zing.zalo" />

        <activity
            android:name="com.zalocn.TranslateSettingsActivity"
            android:label="Zalo 汉化设置"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 待办提醒闹钟接收器：只接系统按 PendingIntent 送达的本模块广播。
             注意：exported=false 意味着只有同 UID 才能触发；闹钟由 Zalo 进程
             排期、经系统送达，真机必须验证到点是否真响——若被系统拦截，
             需改 exported=true（另加权限保护）才能用。 -->
        <!-- 待办提醒接收器：必须 exported=true——闹钟 PendingIntent 由 Zalo 进程创建，
             目标是另一个 App（com.zalocn）的组件；exported=false 时系统会按“非导出组件”
             拒收（创建者 UID 与目标 UID 不同）。风险：任意 App 也能发同 Action 广播，
             最坏情况只是伪造一条提醒通知（onReceive 只认 ACTION_REMINDER 且只发通知，
             不读不写任何数据），可接受。 -->
        <receiver
            android:name="com.zalocn.ReminderReceiver"
            android:exported="true" />
    </application>
</manifest>
